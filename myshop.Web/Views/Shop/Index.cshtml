@using myshop.BLL.DTOs.Product
@using myshop.Common
@model PagedResult<ProductReadDto>

@{
    ViewData["Title"] = "Shop";

    const int maxPagesToShow = 5;

    int startPage = Math.Max(1, Model.PageNumber - 2);
    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage + 1 < maxPagesToShow)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}

<style>

    .shop-header {
        background: linear-gradient(135deg,#1e3a8a,#2563eb);
        color: white;
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 35px;
    }

        .shop-header h1 {
            font-weight: 700;
        }

</style>

<div class="shop-header">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <h1>

                <i class="fas fa-store me-2"></i>

                Shop

            </h1>

            <p class="mb-0">

                Discover our latest products.

            </p>

        </div>

        <span class="badge bg-light text-dark fs-6">

            @Model.FilteredCount Products

        </span>

    </div>

</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.Search))
{
    <div class="alert alert-primary">

        Search Results For

        <strong>"@ViewBag.Search"</strong>

    </div>
}

@if (!Model.Data.Any())
{
    <div class="text-center py-5">

        <i class="fas fa-box-open fa-4x text-secondary mb-3"></i>

        <h3>No Products Found</h3>

        <p class="text-muted">

            We couldn't find any products matching your search.

        </p>

        <a asp-action="Index"
           class="btn btn-primary">

            Show All Products

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model.Data)
        {
            <partial name="_ProductCard" model="item" />
        }

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5">

            <ul class="pagination justify-content-center">

                <!-- Previous -->

                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@ViewBag.Search">

                        <i class="fas fa-angle-left"></i>

                    </a>

                </li>

                <!-- First Page -->
                @if (startPage > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@ViewBag.Search">

                            1

                        </a>

                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">

                            <span class="page-link">

                                ...

                            </span>

                        </li>
                    }
                }

                <!-- Middle Pages -->
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@ViewBag.Search">

                            @i

                        </a>

                    </li>
                }

                <!-- Last Page -->
                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">

                            <span class="page-link">

                                ...

                            </span>

                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@Model.TotalPages"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@ViewBag.Search">

                            @Model.TotalPages

                        </a>

                    </li>
                }

                <!-- Next -->

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@ViewBag.Search">

                        <i class="fas fa-angle-right"></i>

                    </a>

                </li>

            </ul>

        </nav>
    }
}