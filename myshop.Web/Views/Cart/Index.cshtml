@using myshop.Web.ViewModels
@model CartVM
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-cart3"></i>
            Shopping Cart
        </h2>

        @if (Model.Items.Any())
        {
            <form asp-action="Clear"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="btn btn-outline-danger">

                    Clear Cart

                </button>

            </form>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info text-center py-5">

            <h4>Your cart is empty.</h4>

            <p class="mb-3">
                Start shopping and add some products.
            </p>

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-primary">
                Continue Shopping
            </a>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td width="90">

                                        <img src="/@item.ImageUrl"
                                             class="img-thumbnail"
                                             style="width:70px;height:70px;object-fit:cover;" />

                                    </td>

                                    <td class="fw-semibold">
                                        @item.ProductName
                                    </td>

                                    <td class="text-center">
                                        @item.Price.ToString("C")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <form asp-action="Decrease"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm">

                                                    -

                                                </button>

                                            </form>

                                            <button class="btn btn-light btn-sm"
                                                    disabled>

                                                @item.Quantity

                                            </button>

                                            <form asp-action="Increase"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm">

                                                    +

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                    <td class="text-center fw-bold">
                                        @item.Total.ToString("C")
                                    </td>

                                    <td class="text-center">

                                        <form asp-action="Remove"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="btn btn-danger">

                                                Remove

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="row mt-4 justify-content-end">

            <div class="col-md-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h5 class="mb-4">
                            Order Summary
                        </h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Items</span>
                            <span>@Model.TotalItems</span>
                        </div>

                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3">
                            <span>Total</span>
                            <span>@Model.OrderTotal.ToString("C")</span>
                        </div>

                        <a 
                            asp-action="Index"
                            asp-controller="Checkout"
                            class="btn btn-success w-100 mt-4">
                            Checkout
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>