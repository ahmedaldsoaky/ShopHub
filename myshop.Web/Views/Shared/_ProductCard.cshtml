@using myshop.BLL.DTOs.Product
@Html.AntiForgeryToken()
@model ProductReadDto

<div class="col-xl-3 col-lg-4 col-md-6">

    <div class="card product-card h-100">

        <img src="/@Model.ImgPath"
             class="product-img"
             alt="@Model.Name"
             onerror="this.src='/images/no-image.png'" />

        <div class="card-body d-flex flex-column">

            <h5 class="fw-bold mb-1">

                @Model.Name

            </h5>

            <span class="badge bg-light text-dark align-self-start mb-2">

                @Model.CategoryName

            </span>

            <p class="description text-muted mb-3">

                @(Model.Description.Length > 70
                    ? Model.Description[..70] + "..."
                    : Model.Description)

            </p>

            <h4 class="price mb-3">

                @Model.Price.ToString("N2") EGP

            </h4>

            <div class="mt-auto d-grid gap-2">

                <form asp-controller="Cart"
                      asp-action="Add"
                      method="post">

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="returnUrl"
                           value="@Context.Request.Path" />

                    <button type="submit"
                            class="btn btn-success btn-lg w-100">

                        <i class="fas fa-cart-plus me-2"></i>

                        Add To Cart

                    </button>

                </form>

                <a asp-controller="Shop"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">

                    <i class="fas fa-eye me-1"></i>

                    View Details

                </a>

            </div>

        </div>

    </div>

</div>