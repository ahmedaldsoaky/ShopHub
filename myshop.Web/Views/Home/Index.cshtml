@using myshop.BLL.DTOs.Product
@model IReadOnlyList<ProductReadDto>

@{
    ViewData["Title"] = "Home";
}

<section class="py-5 text-center">

    <div class="container">

        @if (TempData["Success"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <h1 class="display-4 fw-bold mb-3">
            Welcome to <span class="text-primary">MyShop</span>
        </h1>

        <p class="lead text-muted mb-4">
            Discover high-quality products at great prices.
            Shop with confidence and enjoy a seamless experience.
        </p>

        <a asp-controller="Shop"
           asp-action="Index"
           class="btn btn-primary btn-lg px-4">

            <i class="fas fa-shopping-bag me-2"></i>
            Shop Now

        </a>

    </div>

</section>

<hr class="my-5" />

<section>

    <div class="text-center mb-4">

        <h2 class="fw-bold">
            Why Choose MyShop?
        </h2>

        <hr class="my-5" />

        <h2 class="text-center fw-bold mb-4">
            Featured Products
        </h2>

        <div class="row g-4">

            @foreach (var item in Model)
            {
                <partial name="_ProductCard"
                         model="item" />
            }

        </div>

        <div class="text-center mt-5">

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-outline-primary btn-lg">

                View All Products

            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>

                <h5>Fast Delivery</h5>

                <p class="text-muted">
                    Receive your orders quickly and safely.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="fas fa-medal fa-3x text-success mb-3"></i>

                <h5>High Quality</h5>

                <p class="text-muted">
                    Carefully selected products with premium quality.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="fas fa-headset fa-3x text-danger mb-3"></i>

                <h5>24/7 Support</h5>

                <p class="text-muted">
                    Our support team is always ready to help.
                </p>

            </div>

        </div>

    </div>

</section>